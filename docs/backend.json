
{
  "entities": {
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Handcrafted crochet products in the boutique.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string", "format": "uri" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "price", "image", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Customer order requests recorded in the studio scrolls.",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "items": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "customerName", "total", "status", "createdAt"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "type": "object",
      "description": "Global visual settings for the boutique (Hero visuals, banners).",
      "properties": {
        "id": { "type": "string" },
        "value": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "structure": [
      {
        "path": "/products/{productId}",
        "entityName": "Product"
      },
      {
        "path": "/orders/{orderId}",
        "entityName": "Order"
      },
      {
        "path": "/settings/{settingId}",
        "entityName": "AppSetting"
      }
    ]
  }
}
