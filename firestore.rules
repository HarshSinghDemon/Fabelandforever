rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FABLE & FOREVER - FAILSAFE SECURITY RULES v2.0
     * 
     * 1. PUBLIC READ: Products and Settings are globally readable.
     * 2. PUBLIC CREATE: Anyone can place an order.
     * 3. ARTISAN ACCESS: Any authenticated user can manage the studio.
     *    (You can restrict this further once your roles_admin collection is populated)
     */

    // Products: Public read, Authenticated write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site Visuals: Public read, Authenticated write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: Public create, Authenticated read/write
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Admin Roles: Managed by authenticated artisans
    match /roles_admin/{uid} {
      allow read, write: if request.auth != null;
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}