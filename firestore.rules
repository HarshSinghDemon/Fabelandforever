rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a robust, multi-tier authorization model for 'The Crochet Studio'.
     * 1. Public Catalog & Visuals: Products and Site Settings are globally viewable but only modifiable by administrators.
     * 2. Order Management: Orders can be created by anyone (guest/auth) but only managed by administrators.
     * 3. Role-Based Access Control (RBAC): A dedicated collection (/roles_admin) identifies 
     *    administrators who can oversee products and manage customer requests.
     */

    // --- Helper Functions ---

    /** Checks if the request is from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user has an entry in the admin roles collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the product catalog. Publicly readable; Admin-only writes.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for site-wide visual settings (Hero, Custom Banners).
     * Publicly readable for guest experience; Admin-only management.
     */
    match /settings/{settingId} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    /**
     * @description Rules for orders. Anyone can place an order; only admins can list/manage.
     */
    match /orders/{orderId} {
      allow create: if true;
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list, update, delete: if isAdmin();
    }

    /**
     * @description Rules for user-specific design ideas.
     */
    match /users/{userId}/design_ideas/{designIdeaId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.ownerId == userId;
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @description Database Access Control (DBAC) markers for admin users.
     */
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }
  }
}