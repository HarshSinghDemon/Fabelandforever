
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a Role-Based Access Control (RBAC) model specifically designed for an 
     * e-commerce admin panel. It distinguishes between "Public Users" (who browse the shop) 
     * and "Admin Users" (who manage the inventory).
     *
     * DATA STRUCTURE
     * - /products/{productId}: The primary collection for inventory. Items are visible to the public 
     *   only when 'isPublished' is set to true.
     * - /admin_users/{adminId}: A marker collection where the document ID corresponds to the 
     *   Firebase Auth UID of an authorized administrator.
     * - /orders/{orderId}: Customer purchase records.
     * - /settings/{settingId}: Global boutique curation settings.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function isPublished() {
      return resource.data.isPublished == true;
    }

    // --- Collection Rules ---

    match /products/{productId} {
      allow get: if isPublished() || isAdmin();
      allow list: if true; // Public listing allowed; developers filter by isPublished == true in query.
      allow write: if isAdmin();
    }

    match /admin_users/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // Managed via console/Admin SDK
    }

    match /orders/{orderId} {
      allow create: if true; // Guests can place orders
      allow read, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if true;
      allow write: if isAdmin();
    }
  }
}
