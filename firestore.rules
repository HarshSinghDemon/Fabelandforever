
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FABLE & FOREVER - SECURITY RULES v1.5
     * 
     * 1. PUBLIC READ: Products and Settings are globally readable for landing page visuals.
     * 2. PUBLIC CREATE: Anyone can place an order (orders collection).
     * 3. MASTER WEAVER ACCESS: harshroop100@gmail.com has full authority over all documents.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "harshroop100@gmail.com" ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    // --- Rules ---

    // Product Catalog: Publicly readable, admin managed.
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Site Visuals & Settings: Publicly readable, admin managed.
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Orders: Public can create, Admin can manage.
    match /orders/{orderId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }

    // Admin Roles: Read-only registry.
    match /roles_admin/{uid} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if false;
    }
    
    // Legacy path for backward compatibility if needed
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
  }
}
