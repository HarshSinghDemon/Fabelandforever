rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * MASTER WEAVER SECURITY RULES - v1.5 (Final Failsafe)
     * These rules allow visitors to see your treasures while keeping
     * management restricted to you (harshroop100@gmail.com).
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "harshroop100@gmail.com" ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    // --- Collection Rules ---

    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Visitors can manifest new orders
      allow create: if true;
      // Only the artisan or the specific customer can see the order details
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Only the artisan can see the full list of scrolls
      allow list: if isAdmin();
      // Only the artisan can update status or unravel a record
      allow update, delete: if isAdmin();
    }

    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if false; 
    }
  }
}